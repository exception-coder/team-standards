{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoooni.local/schemas/planning-evidence-trace-v2.schema.json",
  "title": "Planning Evidence Trace V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "traceId", "scopeId", "primaryProject", "purpose", "round", "maxRounds", "complete", "sources", "remainingGaps"],
  "properties": {
    "version": { "const": "planning-evidence-trace-v2" },
    "traceId": { "type": "string", "minLength": 1 },
    "scopeId": { "type": "string", "minLength": 1 },
    "primaryProject": { "type": "string", "minLength": 1 },
    "purpose": { "enum": ["INITIAL_SPEC", "VALUE_ANALYSIS", "EFFORT_ESTIMATE"] },
    "round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "maxRounds": { "const": 3 },
    "complete": { "type": "boolean" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/sourceEntry" } },
    "remainingGaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } }
  },
  "$defs": {
    "relation": { "enum": ["PRIMARY", "REFACTORS", "MIGRATES_FROM", "DEPENDS_ON", "INTEGRATES_WITH"] },
    "projectRole": { "enum": ["CURRENT_IMPLEMENTATION", "LEGACY_SOURCE", "MIGRATION_SOURCE", "DEPENDENCY", "INTEGRATION_PARTNER"] },
    "sourceType": { "enum": ["DOMAIN_KNOWLEDGE", "GRAPHIFY", "DDL", "ROUTE_MAP", "SOURCE", "CROSS_PROJECT_TOPOLOGY"] },
    "status": { "enum": ["HIT", "NO_HIT", "SOURCE_MISSING", "EXECUTION_ERROR", "NOT_APPLICABLE", "SKIPPED_WITH_REASON"] },
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "source", "sourceProject", "projectPath", "projectRole", "relation", "target", "attempted", "status", "resultChars", "queryReason"],
      "properties": {
        "entryId": { "type": "string", "minLength": 1 },
        "retryOf": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/sourceType" },
        "sourceProject": { "type": "string", "minLength": 1 },
        "projectPath": { "type": "string", "minLength": 1 },
        "projectRole": { "$ref": "#/$defs/projectRole" },
        "relation": { "$ref": "#/$defs/relation" },
        "target": { "type": ["string", "null"] },
        "attempted": { "type": "boolean" },
        "status": { "$ref": "#/$defs/status" },
        "resultChars": { "type": "integer", "minimum": 0 },
        "queryReason": { "type": "string", "minLength": 1 },
        "excerpt": { "type": ["string", "null"], "maxLength": 2000 },
        "errorSummary": { "type": ["string", "null"], "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["HIT", "NO_HIT", "SOURCE_MISSING", "EXECUTION_ERROR"] } }, "required": ["status"] },
          "then": { "properties": { "attempted": { "const": true } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["NOT_APPLICABLE", "SKIPPED_WITH_REASON"] } }, "required": ["status"] },
          "then": { "properties": { "attempted": { "const": false } } }
        }
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectKey", "sourceType", "reason"],
      "properties": {
        "projectKey": { "type": "string", "minLength": 1 },
        "sourceType": { "$ref": "#/$defs/sourceType" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
