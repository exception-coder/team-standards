{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Successful state verification evidence v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "checkerVersion": {
      "type": "string",
      "minLength": 1
    },
    "checkerDigest": {
      "type": "string",
      "minLength": 1
    },
    "contractPath": {
      "type": "string",
      "minLength": 1
    },
    "inputFingerprint": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "const": "PASS"
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exitCode": {
            "type": "number",
            "const": 0
          },
          "status": {
            "type": "string",
            "const": "PASS"
          },
          "outputDigest": {
            "type": "string",
            "minLength": 1
          },
          "errorCode": {
            "type": "null"
          }
        },
        "required": [
          "id",
          "command",
          "exitCode",
          "status",
          "outputDigest",
          "errorCode"
        ],
        "additionalProperties": false
      }
    },
    "verifiedAt": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "node",
        "platform"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "checkerVersion",
    "checkerDigest",
    "contractPath",
    "inputFingerprint",
    "status",
    "executions",
    "verifiedAt",
    "environment"
  ],
  "additionalProperties": true
}
