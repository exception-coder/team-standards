{
  "description": "Team Standards hooks: Bash commit guards; a concurrent Write/Edit/MultiEdit guard dispatcher compatible with Claude Code and Codex apply_patch payloads; and privacy-preserving prompt signal plus stale-version reminders. Individual guards remain configurable through their documented TEAM_STANDARDS_* environment variables.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-git-commit-skill.js\"",
            "async": false
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-commit-no-ai-signature.js\"",
            "async": false
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/write-guard-dispatcher.js\"",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-signal-capture.js\"",
            "async": false
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-plugin-version-stale.js\"",
            "async": false
          }
        ]
      }
    ]
  }
}
