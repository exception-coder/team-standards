{
  "description": "Team Standards hooks: commit-message validation for Bash and exec_command; a concurrent write guard dispatcher; and privacy-preserving prompt signal plus stale-version reminders. Commit size and Skill invocation are not gates.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-commit-no-ai-signature.js\"",
            "async": false
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/write-guard-dispatcher.js\"",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-signal-capture.js\"",
            "async": false
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-plugin-version-stale.js\"",
            "async": false
          }
        ]
      }
    ]
  }
}
