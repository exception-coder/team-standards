{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitee.com/wyoooni/team-standards/openspec-governance.v1.schema.json",
  "title": "OpenSpec governance result and evidence v1",
  "oneOf": [{"$ref": "#/$defs/result"}, {"$ref": "#/$defs/evidence"}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference": {
      "type": "object",
      "required": ["path", "heading"],
      "properties": {"path": {"type": "string", "minLength": 1}, "heading": {"type": "string", "pattern": "^#{1,6} .+"}},
      "additionalProperties": false
    },
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fingerprints": {"type": "object", "minProperties": 1, "additionalProperties": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}},
    "view": {
      "type": "object",
      "required": ["id", "files", "disposition", "reason"],
      "properties": {
        "id": {"enum": ["implementation", "contracts", "data", "workflow", "async", "runtime", "architecture", "ui"]},
        "files": {"$ref": "#/$defs/strings"},
        "disposition": {"enum": ["updated", "already-covered", "not-applicable"]},
        "reason": {"type": "string", "minLength": 1},
        "reference": {"$ref": "#/$defs/reference"}
      },
      "allOf": [{"if": {"properties": {"disposition": {"enum": ["updated", "already-covered"]}}}, "then": {"required": ["reference"]}}]
    },
    "plan": {
      "type": "object",
      "required": ["files", "taskIds", "views", "scenarios", "review"],
      "properties": {
        "files": {"$ref": "#/$defs/strings", "maxItems": 1000},
        "taskIds": {"$ref": "#/$defs/strings"},
        "views": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/view"}},
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "files", "taskIds", "reference"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "files": {"$ref": "#/$defs/strings"},
              "taskIds": {"$ref": "#/$defs/strings"},
              "reference": {"$ref": "#/$defs/reference"},
              "verificationIds": {"$ref": "#/$defs/strings"}
            }
          }
        },
        "review": {
          "type": "object",
          "required": ["type", "actor", "result", "reference"],
          "properties": {
            "type": {"enum": ["agent", "human", "independent"]},
            "actor": {"type": "string", "minLength": 1},
            "result": {"const": "PASS"},
            "reference": {"$ref": "#/$defs/reference"},
            "inputFingerprint": {"$ref": "#/$defs/digest"}
          }
        },
        "dedup": {
          "type": "object",
          "required": ["query", "decision"],
          "properties": {
            "query": {"type": "string", "minLength": 1},
            "selection": {"enum": ["new", "continue", "small"]},
            "originalGoal": {"type": "string", "minLength": 1},
            "acceptanceBoundary": {"type": "string", "minLength": 1},
            "stage": {"type": "string", "minLength": 1},
            "decision": {"type": "string", "minLength": 1},
            "reference": {"$ref": "#/$defs/reference"}
          }
        },
        "handoff": {
          "type": "object",
          "required": ["stage", "nextTask", "blockers"],
          "properties": {
            "stage": {"type": "string", "minLength": 1},
            "nextTask": {"type": "string", "minLength": 1},
            "blockers": {"type": "array", "maxItems": 0},
            "reference": {"$ref": "#/$defs/reference"}
          }
        },
        "baselines": {"type":"array","items":{"type":"object","required":["module","id","disposition","reason"],"properties":{"module":{"type":"string"},"id":{"enum":["overview","detailed"]},"disposition":{"enum":["updated","already-covered","not-applicable"]},"reason":{"type":"string","minLength":1},"reference":{"$ref":"#/$defs/reference"},"implemented":{"type":"boolean"},"codeVersion":{"type":"string","minLength":1}}}},
        "conflicts": {"type":"array","items":{"type":"object","required":["change","order","reason"],"properties":{"change":{"type":"string","minLength":1},"order":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}}},
        "smallChange": {"type":"object","required":["reason","behaviorUnchanged"],"properties":{"reason":{"type":"string","minLength":1},"behaviorUnchanged":{"const":true}}},
        "verifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "command", "environment", "result", "reference", "inputFingerprint"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "command": {"type": "string", "minLength": 1},
              "files": {"$ref": "#/$defs/strings"},
              "environment": {"type": "string", "minLength": 1},
              "result": {"const": "PASS"},
              "reference": {"$ref": "#/$defs/verificationReference"},
              "inputFingerprint": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["schemaVersion", "policyVersion", "checkerVersion", "status", "findings"],
      "properties": {
        "schemaVersion": {"const": 1},
        "policyVersion": {"const": 3},
        "checkerVersion": {"const": 3},
        "status": {"enum": ["PASS", "NOT_APPLICABLE", "NEEDS_WORK", "CONTEXT_REQUIRED", "CHECK_ERROR"]},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "message"],
            "properties": {"rule": {"type": "string"}, "message": {"type": "string"}}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "schemaVersion",
        "policyVersion",
        "checkerVersion",
        "bindingId",
        "phase",
        "change",
        "base",
        "context",
        "plan",
        "references",
        "inputs"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "policyVersion": {"const": 3},
        "checkerVersion": {"const": 3},
        "bindingId": {"$ref": "#/$defs/digest"},
        "phase": {"enum": ["delivery", "archive"]},
        "change": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "base": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "context": {
          "type": "object",
          "required": ["change", "changeDir", "schema", "tasks", "artifacts"],
          "properties": {
            "change": {"type": ["string", "null"]},
            "changeDir": {"type": "string"},
            "schema": {"type": "string"},
            "tasks": {"type": "array", "items": {"type": "object", "required": ["id", "done"]}},
            "artifacts": {"type": "object", "additionalProperties": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}
          }
        },
        "plan": {"$ref": "#/$defs/plan", "required": ["verifications"]},
        "references": {"$ref": "#/$defs/fingerprints"},
        "inputs": {"$ref": "#/$defs/fingerprints"}
      }
    },
    "verificationReference": {
      "oneOf": [
        {"$ref": "#/$defs/reference"},
        {
          "type": "object",
          "required": ["path"],
          "properties": {"path": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        }
      ]
    }
  }
}
