{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitee.com/wyoooni/team-standards/openspec-governance.v1.schema.json",
  "title": "OpenSpec governance result and evidence v1",
  "oneOf": [{ "$ref": "#/$defs/result" }, { "$ref": "#/$defs/evidence" }],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reference": {
      "type": "object", "required": ["path", "heading"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "heading": { "type": "string", "pattern": "^#{1,6} .+" }
      }, "additionalProperties": false
    },
    "strings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "fingerprints": {
      "type": "object", "minProperties": 1,
      "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
    },
    "view": {
      "type": "object", "required": ["id", "files", "disposition", "reason", "reference"],
      "properties": {
        "id": { "enum": ["implementation", "contracts", "data", "workflow", "async", "runtime", "architecture", "ui"] },
        "files": { "$ref": "#/$defs/strings" },
        "disposition": { "enum": ["updated", "already-covered", "not-applicable"] },
        "reason": { "type": "string", "minLength": 1 },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "plan": {
      "type": "object", "required": ["files", "taskIds", "views", "scenarios", "review", "dedup", "handoff"],
      "properties": {
        "files": { "$ref": "#/$defs/strings", "maxItems": 1000 },
        "taskIds": { "$ref": "#/$defs/strings" },
        "views": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/view" } },
        "scenarios": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "files", "taskIds", "reference"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "files": { "$ref": "#/$defs/strings" },
              "taskIds": { "$ref": "#/$defs/strings" },
              "reference": { "$ref": "#/$defs/reference" },
              "verificationIds": { "$ref": "#/$defs/strings" }
            }
          }
        },
        "review": {
          "type": "object", "required": ["type", "actor", "result", "reference"],
          "properties": {
            "type": { "enum": ["agent", "human", "independent"] },
            "actor": { "type": "string", "minLength": 1 },
            "result": { "const": "PASS" },
            "reference": { "$ref": "#/$defs/reference" },
            "inputFingerprint": { "$ref": "#/$defs/digest" }
          }
        },
        "dedup": {
          "type": "object", "required": ["query", "decision", "reference"],
          "properties": {
            "query": { "type": "string", "minLength": 1 },
            "decision": { "type": "string", "minLength": 1 },
            "reference": { "$ref": "#/$defs/reference" }
          }
        },
        "handoff": {
          "type": "object", "required": ["stage", "nextTask", "blockers", "reference"],
          "properties": {
            "stage": { "type": "string", "minLength": 1 },
            "nextTask": { "type": "string", "minLength": 1 },
            "blockers": { "type": "array", "maxItems": 0 },
            "reference": { "$ref": "#/$defs/reference" }
          }
        },
        "verifications": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "command", "environment", "result", "reference", "inputFingerprint"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "environment": { "type": "string", "minLength": 1 },
              "result": { "const": "PASS" },
              "reference": { "$ref": "#/$defs/reference" },
              "inputFingerprint": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "result": {
      "type": "object", "required": ["schemaVersion", "policyVersion", "checkerVersion", "status", "findings"],
      "properties": {
        "schemaVersion": { "const": 1 }, "policyVersion": { "const": 1 }, "checkerVersion": { "const": 1 },
        "status": { "enum": ["PASS", "NOT_APPLICABLE", "NEEDS_WORK", "CONTEXT_REQUIRED", "CHECK_ERROR"] },
        "findings": { "type": "array", "items": {
          "type": "object", "required": ["rule", "message"],
          "properties": { "rule": { "type": "string" }, "message": { "type": "string" } }
        } }
      }
    },
    "evidence": {
      "type": "object", "required": ["schemaVersion", "policyVersion", "checkerVersion", "bindingId", "phase", "change", "base", "context", "plan", "references", "inputs"],
      "properties": {
        "schemaVersion": { "const": 1 }, "policyVersion": { "const": 1 }, "checkerVersion": { "const": 1 },
        "bindingId": { "$ref": "#/$defs/digest" },
        "phase": { "enum": ["delivery", "archive"] },
        "change": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "base": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "context": {
          "type": "object", "required": ["change", "changeDir", "schema", "tasks", "artifacts"],
          "properties": {
            "change": { "type": "string" }, "changeDir": { "type": "string" }, "schema": { "type": "string" },
            "tasks": { "type": "array", "items": { "type": "object", "required": ["id", "done"] } },
            "artifacts": { "$ref": "#/$defs/fingerprints" }
          }
        },
        "plan": { "$ref": "#/$defs/plan", "required": ["verifications"] },
        "references": { "$ref": "#/$defs/fingerprints" },
        "inputs": { "$ref": "#/$defs/fingerprints" }
      }
    }
  }
}
