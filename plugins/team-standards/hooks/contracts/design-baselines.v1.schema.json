{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current design module bindings v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "managed",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "managed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scopes",
          "capabilities",
          "owner",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "active",
              "gap",
              "retired"
            ]
          },
          "shared": {
            "type": "boolean"
          },
          "codeVersion": {
            "type": "string",
            "minLength": 1
          },
          "overview": {
            "type": "object",
            "required": [
              "path",
              "heading"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "heading": {
                "type": "string",
                "pattern": "^#{1,6} .+"
              }
            },
            "additionalProperties": false
          },
          "detailed": {
            "type": "object",
            "required": [
              "path",
              "heading"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "heading": {
                "type": "string",
                "pattern": "^#{1,6} .+"
              }
            },
            "additionalProperties": false
          },
          "plan": {
            "type": "string",
            "minLength": 1
          },
          "replacedBy": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "active"
                }
              }
            },
            "then": {
              "required": [
                "overview",
                "detailed",
                "codeVersion"
              ]
            },
            "else": {
              "required": [
                "plan"
              ]
            }
          }
        ]
      }
    }
  }
}
